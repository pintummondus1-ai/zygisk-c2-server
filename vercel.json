{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    { "src": "/c", "dest": "/server.js" },
    { "src": "/api/verify-license", "dest": "/server.js" },
    { "src": "/api/c", "dest": "/server.js" },
    { "src": "/api/admin/(.*)", "dest": "/server.js" },
    { "src": "/sse", "dest": "/server.js" },
    { "src": "/events", "dest": "/server.js" },
    { "src": "/health", "dest": "/server.js" },
    { "src": "/ping", "dest": "/server.js" },
    { "src": "/", "dest": "/server.js" }
  ]
}
